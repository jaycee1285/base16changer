// Orchis Color Palette — generated by base16changer
// Scheme: {{scheme-name}}
// Author: {{scheme-author}}

// Accent (from base16 accent field, falls back to base0D)
$accent: #{{accent-hex}};

// Red (base08 → destructive/error)
$red-light: #{{base08-hex}};
$red-dark: #{{base08-hex}};

// Pink (base0E)
$pink-light: #{{base0E-hex}};
$pink-dark: #{{base0E-hex}};

// Purple (base0E)
$purple-light: #{{base0E-hex}};
$purple-dark: #{{base0E-hex}};

// Blue (base0D)
$blue-light: #{{base0D-hex}};
$blue-dark: #{{base0D-hex}};

// Teal (base0C)
$teal-light: #{{base0C-hex}};
$teal-dark: #{{base0C-hex}};

// Green (base0B → success)
$green-light: #{{base0B-hex}};
$green-dark: #{{base0B-hex}};
$sea-light: #{{base0B-hex}};
$sea-dark: #{{base0B-hex}};

// Yellow (base0A → warning)
$yellow-light: #{{base0A-hex}};
$yellow-dark: #{{base0A-hex}};

// Orange (base09)
$orange-light: #{{base09-hex}};
$orange-dark: #{{base09-hex}};

// Grey scale — Orchis defaults
$grey-050: #FAFAFA;
$grey-100: #F2F2F2;
$grey-150: #EEEEEE;
$grey-200: #DDDDDD;
$grey-250: #CCCCCC;
$grey-300: #BFBFBF;
$grey-350: #A0A0A0;
$grey-400: #9E9E9E;
$grey-450: #868686;
$grey-500: #727272;
$grey-550: #555555;
$grey-600: #464646;
$grey-650: #3C3C3C;
$grey-700: #2C2C2C;
$grey-750: #242424;
$grey-800: #212121;
$grey-850: #121212;
$grey-900: #0F0F0F;
$grey-950: #030303;

// White
$white: #FFFFFF;

// Black
$black: #000000;

// Window Buttons
$button-close: #fd5f51;
$button-max: #38c76a;
$button-min: #fdbe04;
